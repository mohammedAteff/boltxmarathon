RewriteEngine On

# Only public routes are mapped into the public directory.
RewriteRule ^$ public/index.php [END]
RewriteCond %{REQUEST_URI} ^(/[A-Za-z0-9_/-]*(?:admin|my))$
RewriteRule ^(?:admin|my)$ %1/ [R=302,L]
RewriteRule ^(admin|my)/$ public/$1/index.php [END]
RewriteRule ^((?:index|wheel|boxes|api|avatar|open|list)\.php|auth/(?:account|login|logout)\.php|admin/users\.php|assets/[A-Za-z0-9_-]+\.(?:css|js|svg|png))$ public/$1 [END]
RewriteRule ^ - [R=404,L]
